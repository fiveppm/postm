---
interface Props {
  class?: string;
  variant?: 'lime-on-ink' | 'ink-on-lime' | 'paper-on-ink';
  size?: number;
}

const { class: cls = '', variant = 'lime-on-ink', size = 40 } = Astro.props;

const palette = {
  'lime-on-ink': { body: '#C8F560', eye: '#0E0F13' },
  'ink-on-lime': { body: '#0E0F13', eye: '#C8F560' },
  'paper-on-ink': { body: '#F6F4EE', eye: '#0E0F13' },
}[variant];
---

<!-- postmonster sign: friendly geometric monster that reads as a blocky P (brand/) -->
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  fill="none"
  width={size}
  height={size}
  class={cls}
  role="img"
  aria-label="Postmonster"
>
  <rect x="4" y="4" width="56" height="34" rx="14" fill={palette.body}></rect>
  <rect x="4" y="4" width="28" height="56" rx="12" fill={palette.body}></rect>
  <circle cx="22" cy="19" r="5.5" fill={palette.eye}></circle>
  <circle cx="42" cy="19" r="5.5" fill={palette.eye}></circle>
  <path d="M33 38h3.4l-1.7 5.8zM38.3 38h3.4l-1.7 5.8zM43.6 38h3.4l-1.7 5.8z" fill={palette.body}
  ></path>
</svg>
