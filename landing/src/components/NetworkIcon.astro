---
import { networkIcons } from '../data/network-icons';

interface Props {
  icon: string | null;
  name: string;
  class?: string;
}

const { icon, name, class: cls = '' } = Astro.props;

const data = icon ? networkIcons[icon] : undefined;

const words = name.replace(/[^A-Za-z0-9 ]/g, ' ').split(/\s+/).filter(Boolean);
const initials = ((words[0]?.[0] ?? '?') + (words[1]?.[0] ?? words[0]?.[1] ?? '')).toUpperCase();
---

{
  data ? (
    <svg viewBox="0 0 24 24" class={cls} role="img" aria-label={name} fill="currentColor">
      <path d={data.path} />
    </svg>
  ) : (
    <span
      class:list={['inline-flex items-center justify-center font-mono font-bold', cls]}
      role="img"
      aria-label={name}
    >
      {initials}
    </span>
  )
}
