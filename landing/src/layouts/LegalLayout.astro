---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { site } from '../data/site';

interface TocItem {
  id: string;
  title: string;
}

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  toc: TocItem[];
}

const { title, description, canonicalPath, toc } = Astro.props;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath}>
  <Header />

  <main class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <header class="border-b border-paper-line pb-8">
      <SectionLabel label="legal" />
      <h1 class="display-lg mt-4">{title}</h1>
      <p class="mono-label mt-5 text-ink-mute">
        effective date: {site.effectiveDate} · {site.legalName}
      </p>
    </header>

    <div class="mt-10 grid gap-12 lg:grid-cols-[220px_1fr]">
      <nav class="lg:sticky lg:top-24 lg:self-start" aria-label="Table of contents">
        <p class="mono-label text-ink-mute">on this page</p>
        <ul class="mt-4 space-y-2.5">
          {
            toc.map((item) => (
              <li>
                <a
                  href={`#${item.id}`}
                  class="text-sm leading-snug text-ink-mute transition-colors hover:text-ink"
                >
                  {item.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <article class="legal prose-legal max-w-3xl">
        <slot />
      </article>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style is:global>
  .legal {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #414855;
  }

  .legal h2 {
    margin-top: 2.75rem;
    margin-bottom: 0.875rem;
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #0e0f13;
    scroll-margin-top: 6rem;
  }

  .legal h3 {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.175rem;
    font-weight: 650;
    color: #0e0f13;
    scroll-margin-top: 6rem;
  }

  .legal p {
    margin-bottom: 1rem;
  }

  .legal ul {
    margin: 0 0 1rem 1.25rem;
    list-style: disc;
  }

  .legal li {
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
  }

  .legal a {
    color: #0e0f13;
    text-decoration: underline;
    text-decoration-color: #ddd7c9;
  }

  .legal a:hover {
    text-decoration-color: currentColor;
  }

  .legal strong {
    color: #0e0f13;
    font-weight: 650;
  }

  .legal .note {
    margin-bottom: 1.5rem;
    border-left: 3px solid #ff6b57;
    background: rgba(255, 107, 87, 0.08);
    padding: 0.875rem 1.125rem;
    border-radius: 0 0.75rem 0.75rem 0;
    font-size: 0.9375rem;
    color: #0e0f13;
  }
</style>
