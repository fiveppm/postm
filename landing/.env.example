# postmonster: build-time public env for the landing (bundled into the static
# output at `npm run build` / Docker build args — see Dockerfile and docs/deploy.md).

# Application origin: used for the /login redirect and CSP connect-src.
PUBLIC_APP_URL=https://app.postmonster.xyz

# Access-request form endpoint base (POST ${PUBLIC_APP_API_URL}/public/access-requests).
PUBLIC_APP_API_URL=https://app.postmonster.xyz/api

# Public fork of the app (AGPL, linked from the About page).
PUBLIC_SOURCE_CODE_URL=https://github.com/fiveppm/postm

# Operator shown in the footer / legal pages (PRD 10).
PUBLIC_OPERATOR_NAME=Postmonster
PUBLIC_OPERATOR_LEGAL_NAME=Postmonster
PUBLIC_EFFECTIVE_DATE=October 1, 2026
